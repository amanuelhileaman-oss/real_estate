# Application Port and Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String with PostGIS enabled
# Example local: postgresql://username:password@localhost:5432/realestate
# Example cloud: postgresql://username:password@ep-divine-rain.neon.tech/realestate?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/realestate

# JWT Authentication Secrets (Generate secure 64+ char random strings for production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE_MB=10

# Primary Super-Admin Account (Initialized on startup / seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPasswordInProduction123!
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin

